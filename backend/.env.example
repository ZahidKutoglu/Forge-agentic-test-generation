# Leave LLM_PROVIDER=local to run fully offline with the deterministic synthesizer.
# Set openai or anthropic (and the matching key) to enable LLM-backed agents.

LLM_PROVIDER=local
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PYTEST_TIMEOUT_SECONDS=45
MAX_REPAIR_LOOPS=3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
